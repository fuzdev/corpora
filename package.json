{
  "name": "corpora",
  "version": "0.0.1",
  "description": "pinned snapshot of real-code corpora for the fuz ecosystem's language tools",
  "private": true,
  "license": "0BSD",
  "repository": "https://github.com/fuzdev/corpora",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
